---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedPizzas from '../components/FeaturedPizzas.jsx'
import Benefits from '../components/Benefits.astro';
import MenuPreview from '../components/MenuPreview.jsx';
import TestimonialsCarousel from '../components/TestimonialsCarousel.jsx';
---

<Layout title="Traditional Pizza" description='Una masa artesanal junto a las recetas de siempre'>
	<main>
		<Hero />
		<FeaturedPizzas client:load />
		<Benefits />
		<MenuPreview client:visible/>
		<TestimonialsCarousel client:visible />
	</main>	
</Layout>
